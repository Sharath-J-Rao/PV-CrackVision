
# Shared runtime/user data must never be committed.
/data/
node_modules/
build/
dist/
coverage/
.DS_Store
*.log
.env*
!.env.example
.aistudio/
.node/
.node_tmp/

# Runtime-only user training artefacts (never ship labels or trained weights).
/training/feedback/
/server/models/*.user.json
/server/models/*.tmp

/training/cell_annotations/
/server/models/cell.onnx
/server/models/cell.previous.onnx

# App-managed direct-cell YOLO training runtime, working dataset, and generated checkpoints.
/training/.python-runtime/
/training/.cell-yolo-venv/
/training/cell_yolo/
/training/.cell-yolo-ready

# Durable local YOLO training job state (contains paths/logs, not source data).
/training/.cell-yolo-job-state.json
/training/.cell-yolo-job-state.json.*

# Reusable app-trained YOLO checkpoints (local user training data).
/training/models/

# Python bytecode generated by training-worker syntax checks.
/training/__pycache__/

# Python bytecode/cache from training helpers and tests.
__pycache__/
*.py[cod]

# Electron desktop packaging outputs
/desktop-dist/
